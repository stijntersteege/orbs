# Copy to .env and adjust. Never commit .env.

# Port Orbs listens on, on your machine.
ORBS_PORT=8080

# Change this before you run Orbs anywhere but your own laptop.
POSTGRES_PASSWORD=orbs

# Shared secret for the API. Empty = no token required (fine on a private network only).
# Set one before exposing Orbs to the internet, then enter it in the app under Settings.
ORBS_API_TOKEN=

# Create a demo provider (Echo) and an orb called Pip on first start.
ORBS_SEED_DEMO_DATA=true
