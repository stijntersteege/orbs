# Copy to .env and adjust. Never commit .env.

# Port Orbs listens on, on your machine.
ORBS_PORT=8080

# Change this before you run Orbs anywhere but your own laptop.
POSTGRES_PASSWORD=orbs

# The address people open Orbs on. Passkeys only work on this address.
ORBS_PUBLIC_URL=http://localhost:8080

# Set to true when Orbs is only reachable through your reverse proxy (Caddy, Traefik, nginx),
# so sign-in limits count each visitor and Orbs knows the request came in over https.
ORBS_TRUST_FORWARDED_HEADERS=false

# Optional token for scripts: requests that send it as a bearer token act as the first admin.
ORBS_API_TOKEN=

# Optional single sign-on with an OpenID Connect provider (Authentik, Authelia, Keycloak, Google, ...).
# Redirect URI to register: <ORBS_PUBLIC_URL>/api/auth/oidc/callback
ORBS_OIDC_AUTHORITY=
ORBS_OIDC_CLIENT_ID=
ORBS_OIDC_CLIENT_SECRET=
ORBS_OIDC_DISPLAY_NAME=Single sign-on

# Create a demo provider (Echo) and an orb called Pip on first start.
ORBS_SEED_DEMO_DATA=true
